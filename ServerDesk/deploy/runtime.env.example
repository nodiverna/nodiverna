# Copy to .env.runtime next to compose.yaml, then run docker compose --env-file .env.runtime ...; keep it out of Git and Docker build contexts.
# Generate each secret independently: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SITE_ORIGIN=https://localhost:8443
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET
PASSWORD_PEPPER=REPLACE_WITH_ANOTHER_RANDOM_SECRET
# Agent job-signing key (ECDSA P-256, single-line base64 PKCS#8 DER). Generate:
# node -e "console.log(require('crypto').generateKeyPairSync('ec',{namedCurve:'prime256v1'}).privateKey.export({type:'pkcs8',format:'der'}).toString('base64'))"
# Changing it requires reinstalling every agent with a fresh registration.
AGENT_JOB_SIGNING_KEY=REPLACE_WITH_GENERATED_KEY
TRUSTED_CLIENT_IP_HEADER=x-serverdesk-client-ip
# PostgreSQL in the Compose service db. The URL has no password; the password
# is DATABASE_PASSWORD. Generate it once (the db volume keeps its first value):
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
DATABASE_URL=postgres://serverdesk@db:5432/serverdesk
DATABASE_PASSWORD=REPLACE_WITH_RANDOM_SECRET
OBJECT_STORAGE_DRIVER=filesystem
OBJECT_STORAGE_PATH=/data/objects
# Optional: the address that gets the daily usage report of the in-app maintenance (docs/usage-data.md); unset sends nothing.
# This version sends no usage report at all: the function is off (usageDataEnabled in runtime/usage-report.mjs).
# LICENSE_SERVER_URL=

# LAN, e.g. a NAS: CADDY_ADDRESS=https://192.168.1.10, CADDY_SERVER_NAME=192.168.1.10,
# and matching SITE_ORIGIN with :8443. SERVER_NAME covers clients without SNI.
CADDY_ADDRESS=https://localhost
CADDY_SERVER_NAME=localhost
CADDY_TLS=internal
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443
# For a public DNS name, CADDY_TLS=your-email@example.com enables public ACME certificates.

# Azure: Azure Database for PostgreSQL Flexible Server 17 with TLS, e.g.
# DATABASE_URL=postgres://serverdesk@your-server.postgres.database.azure.com:5432/serverdesk?sslmode=require
# and DATABASE_PASSWORD as a Container Apps secret reference; set
# OBJECT_STORAGE_DRIVER=azure and AZURE_STORAGE_ACCOUNT_URL / AZURE_STORAGE_CONTAINER.
# Prefer Managed Identity in Azure; AZURE_STORAGE_CONNECTION_STRING is optional.
# These values are runtime secrets, never Docker build arguments.
