<Project Sdk="Microsoft.NET.Sdk">
  <!-- The DHCP plugin of the ServerDesk agent (docs/agent-plugins.md, docs/dhcp-server.md).
       scripts/build-plugin.mjs reads Version and the Plugin* properties into the signed manifest. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>ServerDesk.Plugin.Dhcp</AssemblyName><RootNamespace>ServerDesk.Plugin.Dhcp</RootNamespace><Version>1.1.1</Version>
    <PluginRole>dhcp</PluginRole><PluginMinAgentVersion>4.16.0</PluginMinAgentVersion><PluginCapabilities>dhcp-read;dhcp-scope-create;dhcp-scope-edit;dhcp-scope-activate;dhcp-scope-deactivate;dhcp-scope-delete;dhcp-superscope-create;dhcp-superscope-edit;dhcp-superscope-activate;dhcp-superscope-deactivate;dhcp-superscope-delete;dhcp-exclusion-add;dhcp-exclusion-remove;dhcp-reservation-add;dhcp-reservation-edit;dhcp-reservation-remove;dhcp-lease-delete;dhcp-option-set;dhcp-option-remove;dhcp-policy-create;dhcp-policy-edit;dhcp-policy-delete;dhcp-failover-create;dhcp-failover-edit;dhcp-failover-remove;dhcp-scope-apply</PluginCapabilities>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><InvariantGlobalization>true</InvariantGlobalization><UseSystemResourceKeys>true</UseSystemResourceKeys>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier><SelfContained>true</SelfContained><PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed><EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <DebugType>embedded</DebugType><NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <!-- The broker-plugin protocol, shared with the agent. -->
  <ItemGroup><Compile Include="../shared/PluginProtocol.cs" Link="PluginProtocol.cs" /></ItemGroup>
  <!-- BuildVersion.DevSuffix: empty, or -dev.<sha7> on a dev build (scripts/build-plugin.mjs). -->
  <Import Project="../../BuildVersion.targets" />
</Project>
