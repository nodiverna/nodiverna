<Project>
  <!-- The dev suffix of a build (runtime/release-version.mjs): empty, or -dev.<sha7>
       from scripts/build-agent-v3.mjs and scripts/build-plugin.mjs on a dev run of the
       release workflows. The target writes it into BuildVersion.DevSuffix, so
       Program.Version (BaseVersion + BuildVersion.DevSuffix) stays a constant and the
       csproj <Version> stays the only source of the base X.Y.Z. -->
  <Target Name="ServerDeskBuildVersion" BeforeTargets="CoreCompile">
    <Error Condition="'$(ServerDeskDevSuffix)' != '' And !$([System.Text.RegularExpressions.Regex]::IsMatch('$(ServerDeskDevSuffix)', '^-dev\.[0-9a-f]{7}$'))" Text="ServerDeskDevSuffix must be empty or -dev. with the first 7 lowercase hex characters of the commit SHA." />
    <PropertyGroup>
      <ServerDeskBuildVersionFile>$(IntermediateOutputPath)ServerDeskBuildVersion.g.cs</ServerDeskBuildVersionFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(ServerDeskBuildVersionFile)" Lines="// Generated by agent/BuildVersion.targets.;internal static class BuildVersion { internal const string DevSuffix = &quot;$(ServerDeskDevSuffix)&quot;%3B }" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(ServerDeskBuildVersionFile)" />
      <FileWrites Include="$(ServerDeskBuildVersionFile)" />
    </ItemGroup>
  </Target>
</Project>
