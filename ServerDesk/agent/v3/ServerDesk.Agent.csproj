<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>ServerDesk.Agent</AssemblyName><Version>4.21.4</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><InvariantGlobalization>false</InvariantGlobalization>
    <PublishSingleFile>true</PublishSingleFile><SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed><PublishAot>false</PublishAot>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType><NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <!-- BuildVersion.DevSuffix: empty, or -dev.<sha7> on a dev build (scripts/build-agent-v3.mjs). -->
  <Import Project="../BuildVersion.targets" />
  <ItemGroup><EmbeddedResource Include="release-public.pem" /><EmbeddedResource Include="THIRD-PARTY-NOTICES.txt" /></ItemGroup>
  <!-- The broker-plugin protocol, shared with every plugin project (docs/agent-plugins.md). -->
  <ItemGroup><Compile Include="../plugins/shared/PluginProtocol.cs" Link="PluginProtocol.cs" /></ItemGroup>
  <ItemGroup>
    <PackageReference Include="SIPSorcery" Version="10.0.17" />
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.6.6" ExcludeAssets="contentFiles" />
    <PackageReference Include="System.Management" Version="10.0.12" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.12" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.12" />
    <!-- Version override: PowerShell.SDK pulls Xml/Pkcs transitively; keep the patched minimum (Pkcs follows Xml). -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>
  <Target Name="RemoveSdkLooseMetadata" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Filename)' == 'build.manifest' Or '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'build.manifest'" />
    </ItemGroup>
  </Target>
</Project>
