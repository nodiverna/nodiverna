SITE_ORIGIN=https://localhost:3000
# Generate fresh values with pnpm setup.
SESSION_SECRET=
PASSWORD_PEPPER=
# Agents execute only work signed with this ECDSA P-256 key (base64 PKCS#8 DER
# or PEM; or AGENT_JOB_SIGNING_KEY_FILE). pnpm setup generates it. Changing it
# requires reinstalling every agent with a fresh registration.
AGENT_JOB_SIGNING_KEY=
# Local PostgreSQL from pnpm db:local up. pnpm setup writes a random
# DATABASE_PASSWORD; the URL never contains the password. A remote host needs
# ?sslmode=require (or verify-ca, verify-full).
DATABASE_URL=postgres://serverdesk@127.0.0.1:5432/serverdesk
DATABASE_PASSWORD=
# Size of the connection pool of each process (default 10).
# DATABASE_POOL_MAX=10
OBJECT_STORAGE_DRIVER=filesystem
OBJECT_STORAGE_PATH=.data/objects
# For scaled Azure web instances use OBJECT_STORAGE_DRIVER=azure instead.
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=serverdesk
# Prefer managed identity; connection strings are supported for local testing.
AZURE_STORAGE_CONNECTION_STRING=
# Only behind an ingress that overwrites this header; origin must be private.
TRUSTED_CLIENT_IP_HEADER=
