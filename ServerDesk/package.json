{
  "name": "serverdesk",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --webpack --experimental-https",
    "build": "node scripts/check-node-modules-links.mjs && next build --webpack",
    "start": "node --env-file-if-exists=.env.local scripts/start.mjs",
    "lint": "eslint --max-warnings 0 app ui lib db runtime scripts tests deploy e2e instrumentation.ts instrumentation-client.ts proxy.ts next.config.ts drizzle.config.ts eslint.config.mjs postcss.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:selfhost": "node --test \"tests/**/selfhost-*.mjs\"",
    "test:e2e": "node scripts/e2e.mjs",
    "test:http": "node scripts/check-node-modules-links.mjs && node scripts/http-test.mjs tests/integration/http-selfhost.mjs",
    "check:audit": "pnpm audit --audit-level high",
    "validate": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:selfhost",
    "setup": "node scripts/init-local.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/selfhost.mjs migrate",
    "db:schema-lock": "node scripts/schema-lock.mjs",
    "db:local": "node scripts/local-db.mjs",
    "owner:bootstrap": "node --env-file-if-exists=.env.local scripts/selfhost.mjs bootstrap-owner",
    "db:maintenance": "node --env-file-if-exists=.env.local scripts/selfhost.mjs maintenance",
    "pipeline": "node scripts/pipeline.mjs",
    "db:generate": "drizzle-kit generate",
    "publisher:init": "node scripts/init-publisher.mjs",
    "agent:build": "node scripts/pipeline.mjs agent"
  },
  "dependencies": {
    "@azure/identity": "^4.14.1",
    "@azure/storage-blob": "^12.34.0",
    "@devolutions/iron-remote-desktop": "0.11.0",
    "@devolutions/iron-remote-desktop-rdp": "0.7.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.4.6",
    "nodemailer": "10.1.7",
    "postgres": "3.4.9",
    "qrcode-generator": "2.0.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/workers-types": "4.20260515.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "fflate": "^0.8.3",
    "jsqr": "1.4.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module",
  "packageManager": "pnpm@11.25.0"
}
