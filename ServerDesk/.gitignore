# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
# Browser smoke test (pnpm test:e2e): credentials of the test installation and run output.
/e2e/.auth/
/e2e/artifacts/
/.data/
/certificates/
*.tsbuildinfo

# next.js
/.next/
/.vinext/
/out/

# Agent release files: the portal serves imported releases from its object
# storage, so the repository and the image hold no agent binaries.
/public/downloads/

# misc
.DS_Store
*.pem
!/agent/v3/release-public.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
# Checkout-local execution profile and tool state; never publish them.
/.build/
/.agents/
/.codex/
/agent/v3/bin/
/agent/v3/obj/
/agent/plugins/*/bin/
/agent/plugins/*/obj/
/agent/v3/tests/**/bin/
/agent/v3/tests/**/obj/
/outputs/
/work/

!.env.example
